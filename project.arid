author = Andrzej Cichocki
buildbot enabled = true
github account = combatopera
name = pyrbo
pydoc_enabled = false
pypi account = combatopera
pyversions += 3
requires += diapyr>=31
tagline = Python JIT compiler for near-native performance of low-level arithmetic
test requires += numpy
years +=
    2015
    2016
    2017
    2020
